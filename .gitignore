# Secrets: the live key lives in `.env`, which must never be committed.
.env
# Fetched / backup data: large, regenerable, sometimes key-adjacent.
data/*.json
!data/.gitkeep
# Python
__pycache__/
*.py[cod]
.venv/
venv/
# Jupyter
.ipynb_checkpoints/
# Reports: the docx is the deliverable and is committed. The pdf and the chart
# images are not. Build scripts live in src/.
reports/*.pdf
reports/*.png
reports/*.py
!reports/TMDB_Movie_Data_Analysis_Report.docx
# My own prep notes for the review. Not a lab deliverable.
docs/CODE_REVIEW.md
docs/PRESENTATION.md
.python-version
.vscode/
