# Copy to `.env` and fill in your own keys. Get them free at
# https://www.themoviedb.org/settings/api (desktop browser).
TMDB_API_KEY=paste-your-v3-api-key-here
TMDB_READ_ACCESS_TOKEN=paste-your-v4-read-token-here
TMDB_BASE_URL=https://api.themoviedb.org/3
OFFLINE_BACKUP_PATH=data/tmdb_backup.json
